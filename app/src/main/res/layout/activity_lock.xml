<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/lockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/lockscreen"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_aurora" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="28dp">

        <com.nextos.launcher.ui.island.NextIslandView
            android:id="@+id/lockIsland"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/lockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-thin"
            android:text="09:41"
            android:textColor="#FFFFFF"
            android:textSize="76sp" />

        <TextView
            android:id="@+id/lockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="#E6FFFFFF"
            android:textSize="18sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/lockNotifications"
            layout="@layout/widget_weather"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />

        <LinearLayout
            android:id="@+id/pinPad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/pinHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_pin"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/pinDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.4"
                android:text="○ ○ ○ ○"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <GridLayout
                android:id="@+id/pinGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="3" />
        </LinearLayout>

        <TextView
            android:id="@+id/slideUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="36dp"
            android:fontFamily="sans-serif"
            android:text="@string/slide_to_unlock"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
