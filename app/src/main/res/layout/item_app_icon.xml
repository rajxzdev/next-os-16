<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iconRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cell_height"
    android:clipChildren="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <FrameLayout
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:background="@drawable/ripple_glass"
            android:contentDescription="@string/home"
            android:padding="0dp"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/lockBadge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:src="@drawable/ic_lock"
            android:visibility="gone" />

        <TextView
            android:id="@+id/removeBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:background="@drawable/bg_jiggle_badge"
            android:gravity="center"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/iconLabel"
        style="@style/Text.NextOS.Label"
        android:layout_width="@dimen/icon_label_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
