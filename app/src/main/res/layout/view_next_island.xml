<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/islandInner"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/island_height"
        android:background="@drawable/bg_island"
        android:gravity="center_vertical"
        android:minWidth="@dimen/island_width_idle"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/islandIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/next_island"
            android:src="@drawable/ic_notification" />

        <TextView
            android:id="@+id/islandText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/next_island"
            android:textColor="@color/island_fg"
            android:textSize="12sp" />
    </LinearLayout>
</merge>
