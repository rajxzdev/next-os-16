<?xml version="1.0" encoding="utf-8"?>
<com.nextos.launcher.ui.glass.LiquidGlassView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_widget"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/battery"
            android:src="@drawable/ic_battery" />

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="100%"
            android:textColor="@color/text_on_glass"
            android:textSize="18sp" />
    </LinearLayout>
</com.nextos.launcher.ui.glass.LiquidGlassView>
